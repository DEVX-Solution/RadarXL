{
  "name": "radarxl",
  "version": "2.0.2",
  "private": true,
  "description": "RadarXL Intelligence 2.0 - Inteligência Comercial, Prospecção de Empresas e Sincronização em Equipe.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && node --test",
    "bundle:backend": "node scripts/bundle-backend.js",
    "migrate": "node -e \"import('./src/storage/migration-runner.js').then(m => m.runJsonMigration()).then(console.log)\"",
    "test": "node --test tests/*.test.js",
    "pack": "node scripts/pack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.1.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lighthouse": "^12.8.0",
    "puppeteer": "^24.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
