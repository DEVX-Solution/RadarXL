PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Descoberta gratuita padrão. Valores: auto, osm ou google
# Em auto, usa Google somente se houver chave; caso contrário usa OpenStreetMap.
DISCOVERY_PROVIDER=auto

# Opcional e recomendado pela política do Nominatim para identificar o aplicativo.
OSM_CONTACT_EMAIL=
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Descoberta no Google Maps / Places API (New)
# Opcional. A aplicação funciona sem esta chave usando OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Busca complementar para localizar perfis oficiais no Instagram
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Endpoint de IA compatível com OpenAI Chat Completions
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# IA local gratuita com Ollama. Sem Ollama, o fallback interno continua funcionando.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000

# Opcional: melhora o acesso a perfis públicos do Instagram
INSTAGRAM_SESSION_ID=

LIGHTHOUSE_ENABLED=true
SCREENSHOT_ENABLED=true

DISCOVERY_DELAY_MS=500
WEBSITE_DELAY_MS=800
INSTAGRAM_DELAY_MS=1500
AUDIT_CONCURRENCY=1
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2
MAX_LEADS_PER_SEARCH=20
CANDIDATE_MULTIPLIER=8
WEBSITE_PRECHECK_TIMEOUT_MS=8000
SKIP_UNREACHABLE_WEBSITES=true
DEMO_MODE=false
